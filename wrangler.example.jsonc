// The template `npm run setup` fills in as wrangler.jsonc, which stays out of
// git: it names your own Cloudflare database. Local development and tests use
// this file as is when wrangler.jsonc doesn't exist yet.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "herald",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "herald",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "HUB", "class_name": "Hub" },
      { "name": "LIMITER", "class_name": "Limiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Hub"] },
    { "tag": "v2", "new_sqlite_classes": ["Limiter"] }
  ],
  // Every minute: retry webhooks, wake snoozed cards, the morning summary; daily tidy-up.
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "APP_NAME": "Herald"
  },
  "observability": { "enabled": true }
}
